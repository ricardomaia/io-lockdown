<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="I/O Lockdown" Manufacturer="Ricardo Maia" Version="1.0.0.0" UpgradeCode="73a1e9c2-5b12-4e92-910f-226cd97ff4f1">
    
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do I/O Lockdown já está instalada." />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="IOLockdown" />
    </StandardDirectory>

    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
      <Component Id="Executable" Guid="a1b2c3d4-e5f6-4789-a1b2-c3d4e5f60789">
        <File Id="AppExe" Source="publish\io-lockdown.exe" KeyPath="yes" />
        
        <!-- Configuração do Serviço -->
        <ServiceInstall Id="ServiceInstaller"
                        Type="ownProcess"
                        Name="IOLockdownService"
                        DisplayName="I/O Lockdown Security Service"
                        Description="Protege adaptadores de rede e portas USB contra ataques físicos."
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Arguments="--service" />
        
        <ServiceControl Id="StartService" Start="install" Stop="both" Remove="uninstall" Name="IOLockdownService" Wait="yes" />

        <!-- Inicialização automática da UI para o usuário -->
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="IOLockdownUI" Value="[#AppExe]" Type="string" />
      </Component>
    </ComponentGroup>

    <!-- Interface básica do Instalador -->
    <ui:WixUI Id="WixUI_Minimal" />
  </Package>
</Wix>
